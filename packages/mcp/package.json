{
  "name": "ocean-uiux-mcp",
  "version": "1.1.0",
  "description": "MCP server for a shadcn/ui registry: 114 RTL-ready components and blocks (radix-nova) any AI client can search and install by name, plus cloning live sites' design tokens into shadcn themes.",
  "keywords": ["mcp", "model-context-protocol", "shadcn", "shadcn-ui", "registry", "rtl", "arabic", "react", "nextjs", "radix"],
  "license": "MIT",
  "author": "AMEER ABDULKAREEM JABBAR LAMI",
  "repository": { "type": "git", "url": "git+https://github.com/amoree-code/Ocean-UIUX-MCP.git", "directory": "packages/mcp" },
  "type": "module",
  "bin": { "ocean-uiux-mcp": "bin/cli.mjs" },
  "exports": { "./server": "./src/server.mjs", "./registry": "./src/registry.mjs" },
  "files": ["bin", "src", "registry", "previews", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "E2E=1 node --test test/*.test.mjs",
    "prepack": "node scripts/bundle.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "playwright-core": "^1.51.1",
    "zod": "^4.6.5"
  }
}
