{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-01",
  "title": "Dashboard 01",
  "description": "A dashboard with sidebar, charts and data table.",
  "dependencies": [
    "@dnd-kit/core",
    "@dnd-kit/modifiers",
    "@dnd-kit/sortable",
    "@dnd-kit/utilities",
    "@tanstack/react-table",
    "zod"
  ],
  "registryDependencies": [
    "sidebar",
    "breadcrumb",
    "separator",
    "label",
    "chart",
    "card",
    "select",
    "tabs",
    "table",
    "toggle-group",
    "badge",
    "button",
    "checkbox",
    "dropdown-menu",
    "drawer",
    "input",
    "avatar",
    "sheet",
    "sonner"
  ],
  "files": [
    {
      "path": "registry/radix-nova/blocks/dashboard-01/page.tsx",
      "type": "registry:page",
      "target": "app/dashboard/page.tsx"
    },
    {
      "path": "registry/radix-nova/blocks/dashboard-01/data.json",
      "type": "registry:file",
      "target": "app/dashboard/data.json"
    },
    {
      "path": "registry/radix-nova/blocks/dashboard-01/components/app-sidebar.tsx",
      "type": "registry:component"
    },
    {
      "path": "registry/radix-nova/blocks/dashboard-01/components/chart-area-interactive.tsx",
      "type": "registry:component"
    },
    {
      "path": "registry/radix-nova/blocks/dashboard-01/components/data-table.tsx",
      "type": "registry:component"
    },
    {
      "path": "registry/radix-nova/blocks/dashboard-01/components/nav-documents.tsx",
      "type": "registry:component"
    },
    {
      "path": "registry/radix-nova/blocks/dashboard-01/components/nav-main.tsx",
      "type": "registry:component"
    },
    {
      "path": "registry/radix-nova/blocks/dashboard-01/components/nav-secondary.tsx",
      "type": "registry:component"
    },
    {
      "path": "registry/radix-nova/blocks/dashboard-01/components/nav-user.tsx",
      "type": "registry:component"
    },
    {
      "path": "registry/radix-nova/blocks/dashboard-01/components/section-cards.tsx",
      "type": "registry:component"
    },
    {
      "path": "registry/radix-nova/blocks/dashboard-01/components/site-header.tsx",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "1000px"
  },
  "categories": [
    "dashboard"
  ],
  "type": "registry:block"
}
